{
  "name": "gerpersonal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Organización personal de Ger: núcleo (bot + API) y programa de PC",
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/desktop"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "core": "npm run start -w @ger/core",
    "dev:core": "npm run dev -w @ger/core",
    "dev:desktop": "npm run dev -w @ger/desktop",
    "dev:web": "npm run dev:web -w @ger/desktop",
    "build:desktop": "npm run build -w @ger/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
